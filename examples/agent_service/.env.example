# ---- 日志 ----
LOG_LEVEL=info
LOG_ENHANCE_ENABLED=true
LOG_ENHANCE_FORMAT=text
# text | json

# ---- 服务 ----
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# ---- Redis (AgentScope storage) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- MCP (可选) ----
AMAP_API_KEY=
CLAWHUB_API_TOKEN=

# ==========================================================
# 企业扩展 bankcomm_adp（ADP_ 前缀，可选）
# 复制为 .env 后按需修改；不设置时走 agent_service 内默认值
# Agent Service（企业扩展 bankcomm_adp）环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
#
# 本文件提供 config.yaml 中 $VAR / ${VAR} 引用的取值来源。
# 所有配置以 config.yaml 为主，环境变量仅通过 $ 引用方式生效。
# ==========================================================

# ---------- 跨知识搜索 ----------
# 供 config.yaml 的 cross_search.api_url（$CROSS_SEARCH_API_URL）展开使用
# 请替换为真实的跨知识搜索接口地址
CROSS_SEARCH_API_URL=https://your-cross-search.example.com/api
