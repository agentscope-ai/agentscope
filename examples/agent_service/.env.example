# ---- 日志 ----
LOG_LEVEL=info
LOG_ENHANCE_ENABLED=true
LOG_ENHANCE_FORMAT=text
# text | json

# ---- 服务 ----
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# ---- Redis (AgentScope storage) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- MCP (可选) ----
AMAP_API_KEY=
CLAWHUB_API_TOKEN=

# ==========================================================
# 企业扩展 bankcomm_adp（ADP_ 前缀，可选）
# 复制为 .env 后按需修改；不设置时走 agent_service 内默认值
# ==========================================================

# ---------- 服务 ----------
# Web UI 标题与健康检查展示的应用名
ADP_APP_NAME="交通银行智能体平台"

# ---------- 管控 ----------
# 审计留痕开关：记录每次 agent 调用（谁/何时/用了哪些工具/输出摘要）
# 日志写入 ADP_AUDIT_LOG_PATH 指定的 JSONL 文件
ADP_AUDIT_ENABLED=true
ADP_AUDIT_LOG_PATH=./logs/audit.jsonl

# 数据脱敏开关：对发往模型的输入做手机号/身份证/银行卡号掩码
ADP_DLP_ENABLED=true

# ---------- 运行时目录 ----------
# 工作区目录（AgentScope 沙箱文件读写根目录）
# ADP_WORKSPACE_DIR=./workspaces
