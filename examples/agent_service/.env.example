# ==========================================================
# Agent Service（企业扩展 bankcomm_adp）环境配置示例
# 复制为 .env 后按需修改：cp .env.example .env
# 配置项均通过环境变量注入，前缀为 ADP_，本文件为可选项。
# ==========================================================

# ---------- 服务 ----------
# Web UI 标题与健康检查展示的应用名
ADP_APP_NAME="交通银行智能体平台"

# ---------- 管控 ----------
# 审计留痕开关：记录每次 agent 调用（谁/何时/用了哪些工具/输出摘要）
# 日志写入 ADP_AUDIT_LOG_PATH 指定的 JSONL 文件
ADP_AUDIT_ENABLED=true
ADP_AUDIT_LOG_PATH=./logs/audit.jsonl

# 数据脱敏开关：对发往模型的输入做手机号/身份证/银行卡号掩码
ADP_DLP_ENABLED=true

# ---------- 运行时目录 ----------
# 工作区目录（AgentScope 沙箱文件读写根目录）
# ADP_WORKSPACE_DIR=./workspaces
