# ==========================================================
# BocomADP 环境变量模板（复制为 .env：cp .env.example .env）
#
# 配置体系：config.yaml 为唯一配置源；本文件中的 BOCOMADP_* 键用于
# 部署期覆盖 config.yaml（优先级更高，嵌套字段用 __ 分隔）。
# 其他裸键（如 DEEPSEEK_API_KEY）仅供 config.yaml 的 $VAR / ${VAR}
# 引用展开，不直接参与配置读取。
# ==========================================================

# ---- 部署期覆盖（BOCOMADP_ 前缀，可选，不设则用 config.yaml / 默认值） ----
BOCOMADP_LOG_LEVEL=info
BOCOMADP_LOGGING__ENHANCE__ENABLED=true
BOCOMADP_LOGGING__ENHANCE__FORMAT=text
# text | json

BOCOMADP_SERVICE__HOST=0.0.0.0
BOCOMADP_SERVICE__PORT=8000
# BOCOMADP_SERVICE__RELOAD=false   # 仅开发期开启

# ---- Redis (AgentScope storage) ----
BOCOMADP_REDIS__HOST=localhost
BOCOMADP_REDIS__PORT=6379

# ---- 模型 API Key（供 config.yaml 的 ${DEEPSEEK_API_KEY} 展开使用） ----
DEEPSEEK_API_KEY=

# ---- 其他第三方密钥（可选） ----
AMAP_API_KEY=
CLAWHUB_API_TOKEN=

# ---- 跨知识搜索（供 config.yaml 的 $CROSS_SEARCH_API_URL 展开使用） ----
CROSS_SEARCH_API_URL=
